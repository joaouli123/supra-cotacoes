# Deixe DATABASE_URL vazia para rodar com SQLite local (demonstração).
# Preencha para usar PostgreSQL (produção / Coolify).
#
# No Coolify, ao criar o banco na mesma stack, use a URL interna:
#   postgres://<usuario>:<senha>@<nome-do-servico>:5432/<banco>
DATABASE_URL=

# true apenas se o Postgres exigir TLS (banco externo). Na rede interna do
# Coolify não é necessário.
DATABASE_SSL=false

# Tamanho do pool de conexões (padrão 10)
DATABASE_POOL_MAX=10

# Defina como false para o container NÃO carregar a massa de demonstração
# automaticamente quando encontrar o banco vazio.
SUPRA_SEED_ON_BOOT=true

# Porta do servidor (o Coolify define automaticamente)
PORT=3000

# ---------------------------------------------------------------- acesso
# Segredo que assina o cookie de sessão. Gere um valor longo e aleatório:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SUPRA_SESSAO_SECRET=

# Conta administrativa criada/atualizada a cada subida do container.
# Deixe em branco para não provisionar nenhuma conta automaticamente.
SUPRA_ADMIN_EMAIL=
SUPRA_ADMIN_SENHA=
SUPRA_ADMIN_NOME=Administrador SUPRA

# ---------------------------------------------------------------- e-mail
# Servidor de saída. A porta 465 fala TLS desde o primeiro byte; 587 e 25
# sobem a conexão com STARTTLS. Sem host, usuário e senha o sistema segue
# funcionando — os envios são registrados como falha e nada é perdido.
SMTP_HOST=
SMTP_PORTA=465
SMTP_USUARIO=
SMTP_SENHA=

# Remetente exibido. Se vazio, usa SMTP_USUARIO. Só use um endereço do
# mesmo domínio autenticado: remetente estranho ao SPF cai em spam.
SMTP_REMETENTE=
SMTP_NOME=SUPRA Cotações
SMTP_RESPONDER_PARA=

# Como as mensagens de cotação são entregues:
#   real           vai para o endereço cadastrado de cada fornecedor
#   redirecionado  sai de verdade, mas tudo cai em EMAIL_REDIRECIONAR_PARA,
#                  com o destinatário pretendido no assunto
#   simulado       nada sai; só fica o registro em email_logs
#
# O padrão é "redirecionado" de propósito. A massa de demonstração tem
# fornecedores com domínio inventado; disparar contra eles geraria devolução
# em massa e queimaria a reputação da conta remetente — junto com a de todos
# os outros sistemas que enviam pelo mesmo domínio.
EMAIL_MODO=redirecionado
EMAIL_REDIRECIONAR_PARA=

# Endereço público da plataforma, usado nos links do e-mail. Obrigatório:
# as mensagens saem de um processo em segundo plano, sem requisição por
# perto de onde deduzir o host.
APP_URL=
