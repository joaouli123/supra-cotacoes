{
  "name": "supra-cotacoes",
  "version": "1.0.0",
  "private": true,
  "description": "SUPRA — Plataforma de Cotacoes Corporativas (sistema demonstrativo)",
  "scripts": {
    "seed": "node --no-warnings scripts/seed.mjs",
    "dev": "next dev -p 3010",
    "build": "next build",
